/* packageA/onboarding/onboarding.wxss */
.page {
  min-height: 100vh;
  padding: 64rpx 40rpx 0;
  display: flex;
  flex-direction: column;
}

/* 步骤指示器 */
.steps {
  display: flex;
  gap: 12rpx;
}

.step-dot {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-border);
  transition: background 0.3s;
}

.step-dot.done {
  background: var(--color-primary);
}

.step-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 48rpx;
}

.step-sub {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin: 16rpx 0 48rpx;
}

/* 选项卡 */
.options {
  flex: 1;
}

.option {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: var(--radius-lg);
  border: 3rpx solid transparent;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.option.selected {
  border-color: var(--color-primary);
  background: rgba(16, 185, 129, 0.06);
}

.option-icon {
  font-size: 48rpx;
  margin-right: 28rpx;
}

.option-texts {
  display: flex;
  flex-direction: column;
}

.option-label {
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.option-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 表单 */
.form {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 100rpx;
  font-size: var(--font-size-base);
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: var(--font-size-lg);
}

.form-unit {
  width: 64rpx;
  text-align: right;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

/* 性别分段选择 */
.seg {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.seg-item {
  padding: 12rpx 48rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
}

.seg-item.active {
  background: var(--color-primary);
  color: #ffffff;
  font-weight: 600;
}

/* 频率选择 */
.days {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.day-option {
  width: calc((100% - 120rpx) / 6);
  aspect-ratio: 1;
  background: #ffffff;
  border-radius: var(--radius-base);
  border: 3rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xl);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.day-option.selected {
  border-color: var(--color-primary);
  background: rgba(16, 185, 129, 0.08);
  color: var(--color-primary);
}

.day-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--color-text-secondary);
}

.day-tip {
  width: 100%;
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin-top: 8rpx;
}

/* 底部按钮 */
.btn-area {
  padding: 40rpx 0 40rpx;
}

/* 同意协议行：勾选框 + 文案（书名号可点进协议页） */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}
/* 未勾选时被拦下：抖一下比 toast 更直接地指向「就是这里」 */
.agree-row.shake {
  animation: agree-shake 0.45s ease-in-out;
}
@keyframes agree-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}
.agree-box {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin: 2rpx 16rpx 0 0;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.agree-box.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.agree-tick {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}
.agree-text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}
.agree-link {
  color: var(--color-primary-dark);
}

.btn-row {
  display: flex;
  gap: 24rpx;
}

.btn-ghost.back {
  width: 200rpx;
}

.btn-primary.next {
  flex: 1;
}

.btn-primary.next.disabled {
  opacity: 0.5;
}
