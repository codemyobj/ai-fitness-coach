/* packageA/reminder/reminder.wxss — 训练提醒设置 */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 机制说明卡（浅绿底，和普通卡片区分开） */
.note-card {
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.note-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #047857;
  margin-bottom: 12rpx;
}
.note-line {
  font-size: var(--font-size-sm);
  color: #065f46;
  line-height: 40rpx;
}

/* 未配置提示 */
.warn-card {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}
.warn-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: #b45309;
  margin-bottom: 12rpx;
}
.warn-line {
  font-size: var(--font-size-sm);
  color: #92400e;
  line-height: 38rpx;
  margin-bottom: 8rpx;
}
.warn-code {
  font-size: 22rpx;
  color: #78350f;
  background: #fef3c7;
  border-radius: var(--radius-base);
  padding: 10rpx 16rpx;
  margin: 8rpx 0;
  word-break: break-all;
}

/* 卡片头 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.card-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
}
.status-tag {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}
.status-tag.tag-on {
  color: var(--color-primary-dark);
  background: #ecfdf5;
}
.status-tag.tag-warn {
  color: #b45309;
  background: #fffbeb;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.row:last-of-type {
  border-bottom: none;
}
.row-label {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}
.row-value {
  font-size: var(--font-size-base);
  color: var(--color-text);
  display: flex;
  align-items: center;
}
.row-arrow {
  color: var(--color-text-light);
  margin-left: 8rpx;
}

.tip-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 38rpx;
  margin: 16rpx 0 8rpx;
}

.btn-primary {
  margin-top: 24rpx;
}
.action-second {
  margin-top: 20rpx;
}

/* 状态卡 */
.state-card {
  text-align: center;
}
.state-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 44rpx;
}
.state-btn {
  margin-top: 24rpx;
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 40rpx;
  line-height: 34rpx;
}
