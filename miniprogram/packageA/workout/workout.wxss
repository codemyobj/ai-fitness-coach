/* packageA/workout/workout.wxss */
.page {
  padding: 24rpx 24rpx 0;
}

.state-box {
  text-align: center;
  padding: 200rpx 0;
  color: var(--color-text-secondary);
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.state-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin-top: 12rpx;
}

/* 失败卡片：把原因直接显示出来 */
.err-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-top: 48rpx;
  border: 2rpx solid #fecaca;
}

.err-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: #b91c1c;
}

.err-msg {
  font-size: var(--font-size-sm);
  color: #7f1d1d;
  background: #fef2f2;
  border-radius: var(--radius-base);
  padding: 20rpx;
  margin: 16rpx 0 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* 空态下的排查线索 */
.debug-box {
  margin: 32rpx 0 24rpx;
  padding: 20rpx;
  background: #f3f4f6;
  border-radius: var(--radius-base);
  font-size: 22rpx;
  line-height: 1.7;
  color: #4b5563;
  text-align: left;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 顶部概况 */
.wk-hero {
  background: linear-gradient(135deg, #111827 0%, #059669 140%);
  color: #ffffff;
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx 32rpx;
}

.wk-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.wk-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
}

.wk-sub {
  font-size: var(--font-size-sm);
  opacity: 0.85;
  margin-top: 8rpx;
}

.wk-timer {
  font-size: var(--font-size-lg);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.wk-progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-top: 28rpx;
  overflow: hidden;
}

.wk-progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #34d399;
  transition: width 0.3s ease;
}

/* ---------- 组间休息倒计时 ---------- */
/* 悬浮条 + 等高 spacer：条本身脱离文档流，靠 spacer 保证不遮挡底部打卡按钮。
   spacer 高度 = 卡片(约 165rpx) + 安全区；用 calc+env 精确补偿，无安全区机型回落到 240rpx */
.rest-spacer {
  height: 240rpx;
  height: calc(240rpx + constant(safe-area-inset-bottom));
  height: calc(240rpx + env(safe-area-inset-bottom));
}

.rest-fixed {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 150;
}

.rest-card {
  background: #111827;
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.28);
}

.rest-card.is-paused {
  background: #374151;
}

.rest-card.is-done {
  background: var(--color-primary-dark);
}

.rest-row {
  display: flex;
  align-items: center;
}

.rest-tap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rest-tap:active {
  opacity: 0.7;
}

.rest-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.rest-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.rest-mid {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.rest-title {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.92);
}

.rest-next {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rest-mini,
.rest-skip {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  margin-left: 8rpx;
}

.rest-skip {
  background: rgba(255, 255, 255, 0.3);
}

.rest-mini:active,
.rest-skip:active {
  opacity: 0.7;
}

.rest-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-top: 16rpx;
  overflow: hidden;
}

.rest-bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #34d399;
  transition: width 0.3s linear;
}

.rest-card.is-done .rest-bar-inner {
  background: #ffffff;
}

/* 已打卡横幅 */
.checked-banner {
  background: rgba(16, 185, 129, 0.1);
  color: var(--color-primary);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-base);
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  line-height: 1.5;
}

/* 动作卡片 */
.ex-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ex-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ex-name {
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.ex-target {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.ex-tips-btn {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.ex-tips-btn:active {
  background: rgba(16, 185, 129, 0.1);
}

/* 渐进超负荷建议行（动作卡内，位于动作名与组输入器之间） */
.sg-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-base);
  background: rgba(16, 185, 129, 0.08);
  border-left: 6rpx solid var(--color-primary);
}

/* 加重 = 明确的正向信号，用主色；保持 = 中性提示，降饱和避免像警告 */
.sg-row.sg-hold,
.sg-row.sg-no-weight {
  background: rgba(107, 114, 128, 0.08);
  border-left-color: var(--color-text-light);
}

.sg-row.sg-reps-up {
  background: rgba(245, 158, 11, 0.1);
  border-left-color: var(--color-accent);
}

.sg-main {
  flex: 1;
  min-width: 0;
}

.sg-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text);
}

.sg-reason {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.sg-apply {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: var(--font-size-sm);
}

.sg-apply:active {
  background: var(--color-primary-dark);
}

/* 底部 */
.wk-footer {
  padding: 40rpx 0 32rpx;
}

/* 动作要点弹层（含 GIF 演示） */
.tips-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}

.tips-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx 48rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.tips-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tips-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.tips-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-light);
  background: var(--color-bg);
  border-radius: 50%;
}

.tips-gif {
  width: 340rpx;
  height: 340rpx;
  display: block;
  margin: 12rpx auto 0;
  background: #f9fafb;
  border-radius: var(--radius-base);
}

.tips-sec {
  margin-top: 24rpx;
}

.tips-sec-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 10rpx;
}

.tips-sec-body {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
  background: var(--color-bg);
  border-radius: var(--radius-base);
  padding: 20rpx 24rpx;
}

.tips-sec-body.warn {
  color: #92400e;
  background: #fffbeb;
}

/* 打卡后的订阅提醒引导 */
.remind-icon {
  font-size: 64rpx;
  text-align: center;
  line-height: 1.2;
}

.remind-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  text-align: center;
  margin: 12rpx 0 10rpx;
}

.remind-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 38rpx;
  text-align: center;
  margin-bottom: 12rpx;
}

.remind-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.remind-row-label {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.remind-row-value {
  font-size: var(--font-size-base);
  color: var(--color-text);
  display: flex;
  align-items: center;
}

.remind-arrow {
  color: var(--color-text-light);
  margin-left: 8rpx;
}

.remind-tip {
  font-size: var(--font-size-sm);
  color: #b45309;
  background: #fffbeb;
  border-radius: var(--radius-base);
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
  line-height: 36rpx;
}

.remind-skip {
  margin-top: 20rpx;
}

/* 打卡结算卡 */
.sum-sheet {
  text-align: center;
  padding-bottom: 48rpx;
}

.sum-icon {
  font-size: 72rpx;
  line-height: 1.2;
}

.sum-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text);
  margin-top: 6rpx;
}

.sum-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 用时是这张卡的主角，给足字号和主色 */
.sum-hero {
  margin: 28rpx 0 8rpx;
}

.sum-hero-value {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
  font-variant-numeric: tabular-nums; /* 数字等宽，换字时不左右跳 */
}

.sum-hero-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin-top: 4rpx;
}

.sum-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.sum-cell {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-base);
  padding: 20rpx 8rpx;
}

.sum-cell-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.2;
}

/* 「1,240 kg」这类带单位的数字比纯数字长，降一档字号才不会被挤压换行 */
.sum-cell-value-sm {
  font-size: var(--font-size-lg);
}

.sum-cell-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.sum-badges {
  margin-top: 24rpx;
  font-size: var(--font-size-base);
  color: #92400e;
  background: #fffbeb;
  border-radius: var(--radius-base);
  padding: 18rpx 20rpx;
  line-height: 38rpx;
}

.sum-share-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-light);
  line-height: 34rpx;
}

/* open-type="share" 必须是 button 元素（微信要求），把默认外观抹平成 .btn-primary */
.sum-share {
  width: 100%;
  margin: 28rpx 0 0;
  line-height: 1.5;
}

.sum-share::after {
  border: none;
}

.sum-ghost {
  margin-top: 20rpx;
}

.sum-done {
  margin-top: 24rpx;
  padding: 12rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
}

