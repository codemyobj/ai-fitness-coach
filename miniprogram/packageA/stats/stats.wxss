/* packageA/stats/stats.wxss — 数据看板 */
.page {
  padding: 24rpx 24rpx 48rpx;
}

.state-box {
  text-align: center;
  padding: 200rpx 0;
  color: var(--color-text-secondary);
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

/* 失败卡片 */
.err-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-top: 48rpx;
  border: 2rpx solid #fecaca;
}

.err-title {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: #b91c1c;
}

.err-msg {
  font-size: var(--font-size-sm);
  color: #7f1d1d;
  background: #fef2f2;
  border-radius: var(--radius-base);
  padding: 20rpx;
  margin: 16rpx 0 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* 卡片头 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.card-stat {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
}

/* 1. 累计概览 */
.ov-grid {
  display: flex;
  margin-top: 8rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.ov-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.2;
}

.ov-item.highlight .ov-value {
  color: var(--color-primary);
}

.ov-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin-top: 8rpx;
}

.ov-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-base);
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 2. 柱状图 */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  margin-top: 24rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-wrap {
  width: 28rpx;
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 100%;
  background: linear-gradient(180deg, #34d399 0%, #10b981 100%);
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s;
}

.bar-zero {
  background: #e5e7eb;
  height: 6rpx;
}

.bar-count {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.bar-label {
  font-size: 18rpx;
  color: var(--color-text-light);
  margin-top: 2rpx;
}

/* 3. 打卡热力图 */
/* 布局：左列星期标签 + 右侧 17 列色块（一列一周），颜色深浅 = 当天训练分钟数 */
.hm {
  display: flex;
  margin-top: 8rpx;
}

.hm-side {
  width: 28rpx;
  padding-top: 26rpx; /* 让位给月份标签行，保证行对齐 */
}

.hm-side-cell {
  height: 26rpx;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--color-text-light);
}

.hm-main {
  flex: 1;
  margin-left: 8rpx;
}

.hm-months {
  display: flex;
  height: 26rpx;
  overflow: hidden; /* 月份文字超出列宽时裁掉，避免顶破卡片 */
}

.hm-month {
  flex: 1;
  font-size: 18rpx;
  line-height: 26rpx;
  color: var(--color-text-light);
  white-space: nowrap;
}

.hm-cols {
  display: flex;
}

.hm-col {
  flex: 1;
  padding-right: 6rpx;
}

.hm-col:last-child {
  padding-right: 0;
}

.hm-cell {
  width: 100%;
  height: 26rpx;
  margin-bottom: 6rpx;
  border-radius: 6rpx;
  background: #eef0f3;
}

.hm-col .hm-cell:last-child {
  margin-bottom: 0;
}

/* 五级色阶：0 无训练 → 4 满档（≥60 分钟） */
.hm-l0 { background: #eef0f3; }
.hm-l1 { background: #d1fae5; }
.hm-l2 { background: #6ee7b7; }
.hm-l3 { background: #10b981; }
.hm-l4 { background: #047857; }

/* 未来日期：留白，不参与点击 */
.hm-future {
  background: transparent;
}

.hm-today {
  border: 2rpx solid var(--color-primary);
}

/* 当前选中：外圈描边（不改变色块本身颜色） */
.hm-sel {
  box-shadow: 0 0 0 2rpx #065f46;
}

.hm-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.hm-tip {
  flex: 1;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.hm-legend {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.hm-legend .hm-cell {
  width: 22rpx;
  height: 22rpx;
  margin: 0 0 0 6rpx;
  border-radius: 4rpx;
}

.hm-legend-text {
  font-size: 20rpx;
  color: var(--color-text-light);
  margin-left: 8rpx;
}

.hm-hint {
  font-size: 20rpx;
  color: var(--color-text-light);
  margin-top: 10rpx;
}

/* 4. 打卡日历 */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx 0 8rpx;
}

.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-secondary);
  border-radius: 50%;
}

.cal-nav-btn:active {
  background: var(--color-bg);
}

.cal-nav-btn.disabled {
  color: #d1d5db;
}

.cal-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  min-width: 200rpx;
  text-align: center;
}

.cal-head {
  display: flex;
  margin-top: 12rpx;
}

.cal-head-cell {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-light);
  padding: 8rpx 0;
}

.cal-row {
  display: flex;
}

.cal-cell {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: var(--radius-base);
  margin: 4rpx 0;
}

.cal-cell.checked {
  background: rgba(16, 185, 129, 0.14);
  color: #065f46;
  font-weight: 700;
}

.cal-cell.today {
  border: 2rpx solid var(--color-primary);
  font-weight: 700;
}

/* 5. 最近训练 */
.log-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.log-row:last-child {
  border-bottom: none;
}

.log-date {
  width: 170rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
}

.log-main {
  flex: 1;
}

.log-focus {
  font-size: var(--font-size-base);
  font-weight: 600;
}

.log-meta {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin-top: 6rpx;
}

.empty-box {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.empty-tip {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.empty-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin-top: 8rpx;
}

.empty-box .btn-primary {
  margin-top: 24rpx;
}
