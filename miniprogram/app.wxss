/* app.wxss — 全局样式与设计变量 */
@import "styles/variables.wxss";

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: var(--font-size-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

view, text, image, button, input {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 顶部深色头部的吸顶行为：训练页 hero 与「我的」页 user-card 共用，保证两页滚动表现一致。
   必须给 z-index —— 定位后与卡片同属定位元素，DOM 靠后的卡片会盖到头部上来。 */
.header-sticky {
  position: sticky;
  top: 0;
  z-index: 100;
}

/* 主按钮 */
.btn-primary {
  background: var(--color-primary);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: var(--font-size-lg);
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary.disabled {
  opacity: 0.5;
}

/* 次级按钮 */
.btn-ghost {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 48rpx;
  font-size: var(--font-size-base);
  padding: 20rpx 0;
  text-align: center;
}

/* 安全区适配（iPhone 底部横条） */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 骨架屏「待命」占位：骨架屏延迟 180ms 才出现，这之前什么都不画，
   用一个有高度的空块撑住首屏，避免内容区在 180ms 内跳动 */
.sk-hold {
  min-height: 320rpx;
}
